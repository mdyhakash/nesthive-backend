model UtilityBill {
  id          String     @id @default(uuid())
  month       DateTime
  totalAmount Decimal    @db.Decimal(10, 2)
  splitType   SplitType  @default(EQUAL)
  status      BillStatus @default(UNSETTLED)
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  splits UtilityBillSplit[]

  @@unique([roomId, month], name: "unique_monthly_bill")
  @@map("utility_bills")
}

model UtilityBillSplit {
  id          String          @id @default(uuid())
  shareAmount Decimal         @db.Decimal(10, 2)
  status      BillSplitStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilityBillId String
  utilityBill   UtilityBill @relation(fields: [utilityBillId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  payment Payment?

  @@unique([utilityBillId, tenantId], name: "unique_bill_split")
  @@map("utility_bill_splits")
}