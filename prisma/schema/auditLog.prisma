model AuditLog {
  id         String @id @default(uuid())
  action     String
  entityType String
  entityId   String
  meta       Json?

  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([entityType, entityId], name: "idx_audit_entity")
  @@map("audit_logs")
}