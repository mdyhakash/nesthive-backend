<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Your Email - Nest Hive</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f7fb;
        color: #1f2937;
        line-height: 1.6;
        padding: 40px 16px;
      }

      .email-wrapper {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }

      .email-container {
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #111827;
        padding: 30px 24px;
        text-align: center;
      }

      .logo {
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      .logo span {
        color: #6366f1;
      }

      .content {
        padding: 40px 32px;
        text-align: center;
      }

      .icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #eef2ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
      }

      .title {
        font-size: 26px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 12px;
      }

      .description {
        color: #6b7280;
        font-size: 15px;
        max-width: 450px;
        margin: 0 auto 28px;
      }

      .otp-box {
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px 16px;
        margin: 0 auto 20px;
        max-width: 320px;
      }

      .otp-label {
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
      }

      .otp {
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #111827;
        line-height: 1.2;
      }

      .expiry {
        display: inline-block;
        background-color: #fff7ed;
        color: #c2410c;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 28px;
      }

      .security-note {
        font-size: 13px;
        color: #9ca3af;
        max-width: 440px;
        margin: 0 auto;
      }

      .footer {
        border-top: 1px solid #f3f4f6;
        padding: 24px 32px;
        text-align: center;
        background-color: #fafafa;
      }

      .footer-text {
        color: #9ca3af;
        font-size: 12px;
        margin-bottom: 6px;
      }

      .footer-brand {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
      }

      @media (max-width: 480px) {
        body {
          padding: 20px 10px;
        }

        .content {
          padding: 32px 20px;
        }

        .title {
          font-size: 23px;
        }

        .otp {
          font-size: 30px;
          letter-spacing: 6px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <!-- Header -->
        <div class="header">
          <div class="logo">Nest<span>Hive</span></div>
        </div>

        <!-- Content -->
        <div class="content">
          <div class="icon">✉️</div>

          <h1 class="title">Verify Your Email</h1>

          <p class="description">
            Hi <%= name %>, welcome to Nest Hive! Please use the verification
            code below to verify your email address and continue setting up your
            owner account.
          </p>

          <!-- OTP -->
          <div class="otp-box">
            <div class="otp-label">Your verification code</div>

            <div class="otp"><%= otp %></div>
          </div>

          <!-- Expiration -->
          <div class="expiry">
            ⏱ This code expires in <%= expirationMinutes %> minutes
          </div>

          <p class="security-note">
            If you didn't request this verification code, you can safely ignore
            this email. Never share your verification code with anyone.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated email. Please do not reply to this message.
          </p>

          <p class="footer-brand">
            © <%= new Date().getFullYear() %> Nest Hive. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
