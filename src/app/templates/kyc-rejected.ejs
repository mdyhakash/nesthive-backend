<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KYC Verification Update - NestHive</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #f4f7fb;
        color: #1f2937;
        line-height: 1.6;
        padding: 40px 16px;
      }
      .email-wrapper {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }
      .email-container {
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }
      .header {
        background-color: #111827;
        padding: 30px 24px;
        text-align: center;
      }
      .logo {
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      .logo span {
        color: #6366f1;
      }
      .hero {
        padding: 40px 32px 20px;
        text-align: center;
      }
      .badge-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 20px;
        background-color: #fef2f2;
        color: #ef4444;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: bold;
        border: 2px solid #fecaca;
      }
      .title {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
      }
      .subtitle {
        font-size: 15px;
        color: #6b7280;
      }
      .content {
        padding: 20px 32px 35px;
      }
      .greeting {
        font-size: 16px;
        color: #374151;
        margin-bottom: 16px;
      }
      .message {
        font-size: 15px;
        color: #4b5563;
        margin-bottom: 24px;
      }
      .reason-box {
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
        padding: 16px 20px;
        margin-bottom: 28px;
      }
      .reason-title {
        font-size: 14px;
        font-weight: 700;
        color: #9a3412;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .reason-text {
        font-size: 14px;
        color: #7c2d12;
        line-height: 1.5;
      }
      .btn-wrapper {
        text-align: center;
        margin: 30px 0;
      }
      .btn {
        background-color: #6366f1;
        color: #ffffff !important;
        text-decoration: none;
        padding: 14px 32px;
        font-weight: 600;
        font-size: 15px;
        border-radius: 8px;
        display: inline-block;
      }
      .footer {
        border-top: 1px solid #eeeeee;
        background-color: #fafafa;
        padding: 20px;
        text-align: center;
      }
      .footer p {
        margin: 0;
        color: #9ca3af;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <div class="header">
          <div class="logo">Nest<span>Hive</span></div>
        </div>
        <div class="hero">
          <div class="badge-icon">!</div>
          <h1 class="title">KYC Verification Needs Attention</h1>
          <p class="subtitle">We could not approve your KYC submission at this time.</p>
        </div>
        <div class="content">
          <p class="greeting">Hi <strong><%= name %></strong>,</p>
          <p class="message">
            Thank you for submitting your verification details to NestHive. Our administration team has reviewed your application, and unfortunately we were unable to approve your KYC documents.
          </p>

          <div class="reason-box">
            <div class="reason-title">Reason for rejection:</div>
            <div class="reason-text"><%= rejectionReason %></div>
          </div>

          <p class="message">
            Don't worry, you can easily review and re-upload the valid documents by logging into your account.
          </p>

          <% if (typeof dashboardUrl !== 'undefined' && dashboardUrl) { %>
          <div class="btn-wrapper">
            <a href="<%= dashboardUrl %>" class="btn" target="_blank">Resubmit KYC Documents</a>
          </div>
          <% } %>

          <p class="message" style="margin-bottom: 0;">
            If you need any clarification, please reach out to our support team.
          </p>
        </div>
        <div class="footer">
          <p>&copy; <%= new Date().getFullYear() %> NestHive. All rights reserved.</p>
        </div>
      </div>
    </div>
  </body>
</html>
