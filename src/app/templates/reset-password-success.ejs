<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset Successful</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f7fb;
        color: #1f2937;
        line-height: 1.6;
        padding: 40px 16px;
      }

      .email-wrapper {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }

      .email-container {
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #111827;
        padding: 30px 24px;
        text-align: center;
      }

      .logo {
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      .logo span {
        color: #6366f1;
      }

      .hero {
        padding: 45px 32px 30px;
        text-align: center;
      }

      .success-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 24px;
        background-color: #ecfdf5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
      }

      .title {
        font-size: 29px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 12px;
      }

      .subtitle {
        font-size: 16px;
        color: #6b7280;
        max-width: 450px;
        margin: 0 auto;
      }

      .content {
        padding: 0 32px 40px;
      }

      .greeting {
        font-size: 16px;
        color: #374151;
        margin-bottom: 18px;
      }

      .message {
        font-size: 15px;
        color: #6b7280;
        margin-bottom: 24px;
      }

      .success-box {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 28px;
        text-align: center;
      }

      .success-title {
        font-size: 15px;
        font-weight: 700;
        color: #166534;
        margin-bottom: 6px;
      }

      .success-text {
        font-size: 14px;
        color: #15803d;
      }

      .security {
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 28px;
      }

      .security-title {
        font-size: 14px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
      }

      .security-text {
        font-size: 13px;
        color: #6b7280;
      }

      .closing {
        text-align: center;
        font-size: 14px;
        color: #9ca3af;
      }

      .footer {
        border-top: 1px solid #f3f4f6;
        padding: 24px 32px;
        text-align: center;
        background-color: #fafafa;
      }

      .footer-text {
        color: #9ca3af;
        font-size: 12px;
        margin-bottom: 6px;
      }

      .footer-brand {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
      }

      @media (max-width: 480px) {
        body {
          padding: 20px 10px;
        }

        .hero {
          padding: 35px 20px 25px;
        }

        .content {
          padding: 0 20px 32px;
        }

        .title {
          font-size: 25px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <!-- Header -->
        <div class="header">
          <div class="logo">Nest<span>Hive</span></div>
        </div>

        <!-- Hero -->
        <div class="hero">
          <div class="success-icon">✓</div>

          <h1 class="title">Password Reset Successful</h1>

          <p class="subtitle">
            Your Nest Hive account password has been successfully updated.
          </p>
        </div>

        <!-- Main Content -->
        <div class="content">
          <p class="greeting">Hi <strong><%= name %></strong>,</p>

          <p class="message">
            Your password has been successfully reset. You can now use your new
            password the next time you sign in to your Nest Hive account.
          </p>

          <!-- Success Message -->
          <div class="success-box">
            <p class="success-title">Password Updated Successfully</p>

            <p class="success-text">
              Your account is secure with your new password.
            </p>
          </div>

          <!-- Security Notice -->
          <div class="security">
            <p class="security-title">🔒 Didn't reset your password?</p>

            <p class="security-text">
              If you did not make this change, please contact the Nest Hive
              support team immediately to secure your account.
            </p>
          </div>

          <p class="closing">
            Stay secure,<br />
            The Nest Hive Team
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated email. Please do not reply to this message.
          </p>

          <p class="footer-brand">
            © <%= new Date().getFullYear() %> Nest Hive. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
